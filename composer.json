{
    "name": "mageprince/module-faq",
    "description": "Magento2 FAQ Module",
    "homepage": "https://github.com/mageprince/magento2-FAQ",
    "type": "magento2-module",
    "version": "2.1.9",
    "license": "GPL-3.0-or-later",
    "support": {
        "issues": "https://github.com/mageprince/magento2-FAQ/issues"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Mageprince\\Faq\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
